# ---------- Required: fill these ----------
# Postgres connection string (local docker-compose default shown)
DATABASE_URL="postgresql://smm:smm@localhost:5432/smm?schema=public"
# Redis connection string. Use rediss:// for TLS (Azure Cache / Upstash)
REDIS_URL="redis://localhost:6379"
# Long random strings. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
# Encrypts provider API keys in the DB. Changing it later makes stored keys unreadable.
ENCRYPTION_KEY=""

# First admin account, created by `npm run db:seed`
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ---------- Optional: sensible defaults ----------
NODE_ENV="development"
PORT=4000
# Public URL of the Next.js site
WEB_ORIGIN="http://localhost:3000"
# Display currency for balances/prices (provider rates are assumed to be in this currency)
CURRENCY="USD"
# Markup applied on provider rates when no provider/service override is set
DEFAULT_MARKUP_PERCENT=30
ORDER_SYNC_INTERVAL_SECONDS=60
SERVICE_SYNC_INTERVAL_MINUTES=360
PROVIDER_TIMEOUT_MS=20000
# Log a warning when a provider balance drops below this
LOW_BALANCE_THRESHOLD=10
# Concurrent provider "add order" calls
DISPATCH_CONCURRENCY=10

# Built-in fake provider for testing without a real SMM account. Keep false in production.
ENABLE_MOCK_PROVIDER=true
